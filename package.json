{
  "name": "@goodapp/ai",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "One shared Anthropic client: a pinned SDK, per-use model constants, a fail-closed precondition guard, usage tracking, and prompt caching — for GoodApp products.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthiasvienne-boop/goodapp-ai.git"
  },
  "homepage": "https://github.com/matthiasvienne-boop/goodapp-ai#readme",
  "bugs": {
    "url": "https://github.com/matthiasvienne-boop/goodapp-ai/issues"
  },
  "type": "commonjs",
  "exports": {
    "./server": {
      "types": "./dist/cjs/server/index.d.ts",
      "require": "./dist/cjs/server/index.js",
      "import": "./dist/esm/server/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/cjs/server/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:pkgs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgs": "node scripts/write-dist-package-json.js",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
